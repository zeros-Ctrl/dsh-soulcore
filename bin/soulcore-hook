#!/bin/sh
# soulcore hook 启动器：按顺序找一个 Python ≥ 3.10，然后交给 cc-hook。
# **失败即放行**：找不到 Python / 任何错误都不阻塞 Claude Code（退出码 0，不输出内容）。
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HOME_DIR=${HOME:-${USERPROFILE:-}}
DATA_HOME=${SOULCORE_HOME:-"$HOME_DIR/.dsh/soulcore"}
LOG_DIR="$DATA_HOME/logs"

log_fail() {
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  printf '%s soulcore-hook: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$LOG_DIR/cc-hook.log" 2>/dev/null || true
}

PY=""
PY_EXTRA=""

try_python() {
  # $1 = 可执行文件（或命令名），$2 = 额外参数（如 "-3"）
  command -v "$1" >/dev/null 2>&1 || [ -x "$1" ] || return 1
  "$1" ${2:-} -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1 || return 1
  PY="$1"
  PY_EXTRA=${2:-}
  return 0
}

# 1) 用户指定  2) python3  3) python  4) Windows 的 py -3  5) DSH 自带运行时
[ -n "${SOULCORE_PYTHON:-}" ] && try_python "$SOULCORE_PYTHON"
[ -z "$PY" ] && try_python python3
[ -z "$PY" ] && try_python python
[ -z "$PY" ] && try_python py -3
if [ -z "$PY" ] && [ -n "$HOME_DIR" ]; then
  for cand in "$HOME_DIR"/.dsh/dsh-runtimes/*/dependencies/python/python.exe \
              "$HOME_DIR"/.dsh/dsh-runtimes/*/dependencies/python/bin/python3; do
    [ -x "$cand" ] || continue
    if try_python "$cand"; then break; fi
  done
fi

if [ -z "$PY" ]; then
  log_fail "找不到 Python 3.10+（可用 SOULCORE_PYTHON 指定）"
  exit 0
fi

exec "$PY" $PY_EXTRA -I "$ROOT/core/run.py" cc-hook "${1:-user-prompt}"
