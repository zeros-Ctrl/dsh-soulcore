{
  "name": "dsh-soulcore",
  "version": "0.10.0",
  "description": "给 DeepSeek Harness 的聊天加上持续人格、平滑情绪与分层长期记忆，支持对话内记住/忘记、QQ(OneBot v11)、B站与主动聊天；兼容项目记忆、Claude Code 和 MCP。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "memory",
    "emotion",
    "long-term-memory"
  ],
  "author": "zeros-Crtl <2735527994@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeros-Ctrl/dsh-soulcore.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "core/soulcore/**/*.py",
    "core/run.py",
    "core/persona.example.md",
    "core/config.example.json",
    "cordis.patch.yml",
    "hooks",
    "bin",
    "commands",
    ".claude-plugin",
    ".mcp.json",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/plugin.test.mjs tests/plugin-stable.test.mjs && cd core && python -m unittest discover -s tests",
    "test:js": "node --test tests/plugin.test.mjs tests/plugin-stable.test.mjs",
    "test:py": "cd core && python -m unittest discover -s tests"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
