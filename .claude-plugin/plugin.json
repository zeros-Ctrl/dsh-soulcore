{
  "name": "soulcore",
  "displayName": "soulcore",
  "version": "0.10.0",
  "description": "给 Claude Code 加上跨会话长期记忆和稳定人格：纯本地、零依赖、只用 Python 标准库。",
  "author": {
    "name": "zeros-Crtl",
    "email": "2735527994@qq.com"
  },
  "homepage": "https://github.com/zeros-Crtl/dsh-soulcore",
  "repository": "https://github.com/zeros-Crtl/dsh-soulcore",
  "license": "MIT",
  "keywords": ["memory", "long-term-memory", "mcp", "hooks", "persona"],
  "userConfig": {
    "pythonPath": {
      "type": "string",
      "title": "Python ≥ 3.10（MCP 用）",
      "description": "MCP server 用哪个解释器。Windows 上如果 MCP 连不上，填 python.exe 的绝对路径；macOS/Linux 一般填 python3。",
      "default": "python"
    }
  },
  "mcpServers": {
    "soulcore": {
      "command": "${user_config.pythonPath}",
      "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/core/run.py", "mcp"]
    }
  }
}
